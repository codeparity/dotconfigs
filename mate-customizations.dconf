[atril]
document-directory=@ms 'file:///home/paw/Desktop'

[atril/default]
window-ratio=(3.2220370346077232, 1.1866161613054129)

[caja-open-terminal]
desktop-opens-home-dir=false

[caja/desktop]
font='Cantarell 12'

[caja/extensions]
disabled-extensions=@as []

[caja/list-view]
default-column-order=['name', 'size', 'type', 'date_modified', 'date_accessed', 'date_created', 'extension', 'group', 'where', 'mime_type', 'octal_permissions', 'owner', 'permissions', 'selinux_context', 'size_on_disk']
default-visible-columns=['name', 'size', 'type', 'date_modified']
default-zoom-level='standard'

[caja/preferences]
default-folder-viewer='icon-view'
preview-sound='never'
show-directory-item-counts='never'
show-icon-text='never'
show-image-thumbnails='never'

[caja/window-state]
geometry='958x485+0+28'
maximized=true
side-pane-view='places'
sidebar-width=194
start-with-location-bar=true
start-with-sidebar=true
start-with-status-bar=true
start-with-toolbar=true

[calc]
button-mode='basic'
show-history=false
source-units='degree'
target-units='radian'

[desktop/accessibility/keyboard]
bouncekeys-beep-reject=true
bouncekeys-delay=300
bouncekeys-enable=false
capslock-beep-enable=false
enable=true
feature-state-change-beep=false
mousekeys-accel-time=1200
mousekeys-enable=false
mousekeys-init-delay=160
mousekeys-max-speed=750
slowkeys-beep-accept=true
slowkeys-beep-press=true
slowkeys-beep-reject=false
slowkeys-delay=300
slowkeys-enable=false
stickykeys-enable=false
stickykeys-latch-to-lock=true
stickykeys-modifier-beep=true
stickykeys-two-key-off=true
timeout=120
timeout-enable=false
togglekeys-enable=false

[desktop/applications/at/mobility]
exec='onboard'
startup=true

[desktop/applications/at/visual]
exec='orca'

[desktop/applications/calculator]
exec='mate-calc'

[desktop/applications/terminal]
exec='mate-terminal'

[desktop/background]
color-shading-type='solid'
picture-filename='/usr/share/backgrounds/linuxmint-uma/vanessaog_conifer.jpg'
picture-options='zoom'
primary-color='rgb(0,0,0)'
secondary-color='rgb(0,0,0)'
show-desktop-icons=true

[desktop/font-rendering]
antialiasing='grayscale'
hinting='medium'

[desktop/interface]
accessibility=false
cursor-blink-time=547
document-font-name='Cantarell 12'
enable-animations=false
font-name='Cantarell 12'
gtk-decoration-layout='menu:minimize,maximize,close'
gtk-theme='Ambiant-MATE-Dark-Yellow'
icon-theme='ubuntu-mono-dark'
monospace-font-name='CaskaydiaMono Nerd Font 12'
window-scaling-factor=0

[desktop/keybindings/custom0]
action='/usr/bin/systemctl suspend'
binding='<Primary><Alt>s'
name='Suspend'

[desktop/keybindings/custom1]
action='/home/paw/bin/kitty'
binding='<Mod4>y'
name='kitty term'

[desktop/keybindings/custom2]
action='/usr/bin/shutter -s'
binding='Print'
name='Take screenshot'

[desktop/media-handling]
automount-open=false
autorun-x-content-ignore=@as []
autorun-x-content-open-folder=@as []
autorun-x-content-start-app=['x-content/software', 'x-content/video-bluray.xml', 'x-content/video-dvd.xml', 'x-content/video-hddvd.xml', 'x-content/video-svcd.xml', 'x-content/video-vcd.xml']

[desktop/peripherals/keyboard]
numlock-state='off'

[desktop/peripherals/keyboard/general]
duplicate-leds=true

[desktop/peripherals/mouse]
accel-profile='default'
cursor-size=32
cursor-theme='Adwaita'
middle-button-enabled=false

[desktop/session]
idle-delay=5
session-start=1785379850
show-hidden-apps=true

[desktop/session/required-components]
windowmanager='marco'

[desktop/sound]
event-sounds=false
theme-name='__no_sounds'

[disk-usage-analyzer/ui]
active-chart='rings'

[engrampa/dialogs/batch-add]
default-extension='.tar.bz2'

[engrampa/dialogs/extract]
overwrite=true
recreate-folders=true
skip-newer=false

[engrampa/general]
encrypt-header=false
unar-open-zip=false

[engrampa/listing]
list-mode='as-folder'
name-column-width=435
show-path=false
sort-method='size'
sort-type='descending'

[engrampa/ui]
sidebar-width=200
window-height=1000
window-width=1920

[eom/plugins]
active-plugins=['fullscreen']

[eom/ui]
image-collection=false
sidebar=false
statusbar=true
toolbar=true

[marco/general]
action-double-click-titlebar='toggle_maximize'
button-layout='menu:minimize,maximize,close'
compositing-manager=true
num-workspaces=4
theme='Ambiant-MATE-Dark-Yellow'
titlebar-font='Cantarell Bold 12'

[marco/global-keybindings]
run-command-1=''
run-command-6=''
run-command-screenshot='disabled'
run-command-terminal='<Mod4>t'
show-desktop='<Mod4>d'
switch-to-workspace-1='<Mod4>1'
switch-to-workspace-2='<Mod4>2'
switch-to-workspace-3='<Mod4>3'
switch-to-workspace-4='<Mod4>4'

[marco/window-keybindings]
maximize='disabled'
maximize-horizontally='disabled'
maximize-vertically='disabled'
minimize='<Mod4>c'
move-to-center='<Mod4>c'
tile-to-corner-ne='<Mod4>w'
tile-to-corner-nw='<Mod4>q'
tile-to-corner-se='<Mod4>x'
tile-to-corner-sw='<Mod4>z'
tile-to-side-e='<Mod4>s'
tile-to-side-w='<Mod4>a'
toggle-maximized='<Mod4>f'
toggle-shaded='disabled'
unmaximize='disabled'

[marco/workspace-names]
name-1='Work 1'
name-2='Work 2'
name-3='Imagine'
name-4='Play'

[notification-daemon]
popup-location='top_right'
theme='slider'

[panel/general]
enable-sni-support=true
object-id-list=['menu-bar', 'notification-area', 'clock', 'show-desktop', 'window-list', 'workspace-switcher', 'object-0', 'object-1', 'object-2', 'object-3', 'object-5', 'object-6', 'object-8', 'object-9', 'object-10', 'object-7', 'object-14', 'object-16', 'object-11', 'object-21', 'object-22', 'object-18', 'object-24', 'object-20', 'object-12', 'object-13', 'object-15', 'object-17', 'object-19']
toplevel-id-list=['top', 'bottom']

[panel/menubar]
icon-size='default'

[panel/objects/clock]
applet-iid='ClockAppletFactory::ClockApplet'
locked=true
object-type='applet'
position=0
relative-to-edge='end'
toplevel-id='top'

