[pluma]
active-plugins=['pythonconsole', 'filebrowser', 'time', 'docinfo', 'modelines', 'spell', 'quickopen']
background-pattern='none'
bottom-panel-active-page=-150108646
bottom-panel-size=140
color-scheme='oblivion'
history-replace-with=["',\n'", '" ,\n', 'logo_cp_sq_grey.svg', 'Faustina']
history-search-for=['\n\t\n\n', 'leader', 'telescope', '[dot]', '[at]', 'pelican', 'master.svg', 'slug', 'Post time:']
side-panel-active-page=827629879
side-panel-size=200
size=(1920, 1000)
state=132
statusbar-visible=true
wrap-mode='GTK_WRAP_WORD'

[pluma/plugins/filebrowser/on-load]
root='file:///'
tree-view=true
virtual-root='file:///home/paw/projects/logos'

[pluma/plugins/pythonconsole]
use-system-font=true

[pluma/plugins/spell]
autocheck-type='always'

[power-manager]
action-critical-battery='nothing'
backlight-battery-reduce=false
brightness-ac=15.1
button-lid-ac='nothing'
button-lid-battery='nothing'
button-power='hibernate'
button-suspend='suspend'
icon-policy='never'
idle-dim-battery=false
info-history-graph-points=true
info-history-graph-smooth=false
info-history-time=7200
info-history-type='time-empty'
info-last-device='/org/freedesktop/UPower/devices/battery_BAT0'
info-page-number=0
info-stats-type='charge-accuracy'
kbd-backlight-battery-reduce=false
sleep-display-ac=1800

[screensaver]
idle-activation-enabled=false
lock-enabled=false
mode='random'
picture-filename='/usr/share/images/desktop-base/desktop-background'
themes=['screensavers-biof', 'screensavers-busyspheres', 'screensavers-colorfire', 'screensavers-cosmos-slideshow', 'screensavers-cyclone', 'screensavers-drempels', 'screensavers-euphoria', 'screensavers-feedback', 'screensavers-fieldlines', 'screensavers-gnomelogo-floaters', 'screensavers-footlogo-floaters', 'screensavers-flocks', 'screensavers-flux', 'screensavers-helios', 'screensavers-hufo_smoke', 'screensavers-hufo_tunnel', 'screensavers-hyperspace', 'screensavers-lattice', 'screensavers-lorenz', 'screensavers-matrixview', 'screensavers-personal-slideshow', 'screensavers-pixelcity', 'screensavers-plasma', 'screensavers-popsquares', 'screensavers-skyrocket', 'screensavers-solarwinds', 'screensavers-spirographx', 'screensavers-sundancer2']

[screenshot]
border-effect='none'
delay=0
include-border=true
include-pointer=true
last-save-directory='file:///home/paw/Desktop'

[search-tool]
default-window-height=429
default-window-maximized=false
default-window-width=554
look-in-folder='/home/paw'

[search-tool/select]
contains-the-text=true

[settings-daemon/plugins/media-keys]
control-center='disabled'
home='<Mod4>e'
media='<Mod4>backslash'
next='<Mod4>bracketright'
pause='disabled'
play='<Mod4>p'
previous='<Mod4>bracketleft'
screensaver='disabled'
search='disabled'
volume-down='<Mod4>minus'
volume-mute='<Mod4>0'
volume-up='<Mod4>equal'

[settings-daemon/plugins/xrandr]
show-notification-icon=false

[stickynotes]
default-height=100
default-width=100
desktop-hide=true
force-default=false
sticky=true
use-system-color=true
use-system-font=true

[system-log]
height=1001
logfile='/var/log/Xorg.0.log'
logfiles=['/var/log/fontconfig.log', '/var/log/alternatives.log', '/var/log/faillog', '/var/log/Xorg.0.log', '/var/log/dpkg.log', '/var/log/README', '/var/log/dpkg.log.1', '/var/log/alternatives.log.1']
